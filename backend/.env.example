# Server
PORT=5002
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Allowed CORS origins (comma-separated, falls back to CLIENT_URL)
# ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# MongoDB (required)
MONGO_URI=mongodb://localhost:27017/smythe
# MONGO_POOL_SIZE=10

# Auth
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# S3 / Object Storage (optional)
# S3_REGION=us-east-1
# S3_ENDPOINT=
# S3_BUCKET=your_bucket_name
# S3_ACCESS_KEY=your_access_key
# S3_SECRET_KEY=your_secret_key

# Email Notifications (Noteify) — POST JSON { apikey, email, subject, body }
NOTEIFY_API_KEY=your-noteify-api-key
# NOTEIFY_URL=https://noteify.org/email/

# Public link used in email CTAs (falls back to CLIENT_URL)
# APP_PUBLIC_URL=https://app.example.com

# Scheduler cron expressions (optional overrides)
# DEADLINE_REMINDER_CRON=*/30 * * * *
# PROGRESS_DIGEST_CRON=0 */4 * * *
